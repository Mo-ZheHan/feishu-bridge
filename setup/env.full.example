# → 仓库根 .env（已被 .gitignore 忽略）。实际在用的完整配置，仅脱敏凭据；
# 比根目录 .env.example 多几项实战开关。监听器经 src/lib/env-config.js 从仓库根加载。

# 飞书自建应用（https://open.feishu.cn 创建）：开机器人能力、事件订阅选「长连接」、加 card.action.trigger 回调
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=<在飞书开放平台获取，勿提交真实值>

# 飞书群组 Chat ID（锁定后省去每次 hook 前的 chat.list 请求）
# 机器人拉进目标群后，可用接口或日志取到 oc_ 开头的 id
FEISHU_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 默认宿主（claude 或 codex）
DEFAULT_AGENT_HOST=claude

# Codex CLI 可执行名（默认 codex）
# CODEX_BIN=codex

# 是否启用飞书通知 (true/false)
NOTIFICATION_ENABLED=true

# 卡片交互有效期（小时，默认 72）。飞书按钮/输入框在这段时间内点击才有效，过后回「已过期」
# NOTIFICATION_EXPIRE_HOURS=72

# 卡片显示 Esc 按钮
ENABLE_ESC_BUTTON=true

# 是否启用声音提醒 (true/false)
SOUND_ENABLED=false

# tmux 会话目标（可选，仅 tmux 用户需要）
# 格式: session_name:window_index.pane_index（如 claude:0.0）；留空自动检测
# CLAUDE_TMUX_TARGET=

# 实时执行通知（PostToolUse hook → live-handler.js）
# 1/true 全捕获；或 tools,output,results 精细控制
FEISHU_LIVE_CAPTURE=1
# Debounce 聚合延迟（毫秒，默认 3000）
FEISHU_LIVE_DEBOUNCE_MS=1500
